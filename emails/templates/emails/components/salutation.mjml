{# emails/templates/emails/components/salutation.mjml #}
<mj-section background-color="#ffffff">
    <mj-column>
        <mj-text>
            <p>
                Hallo
                {{ recipient_profile.salutation_display_name }}
                {{ recipient_profile.last_name }},
            </p>
        </mj-text>
    </mj-column>
    <mj-column>
        <mj-text align="right">
            {% if recipient_profile.erp_nr %}
            <p>Ihre Kunden-Nr.: {{ recipient_profile.erp_nr }}</p>
            {% endif %}
        </mj-text>
    </mj-column>
</mj-section>

<mj-section css-class="editor-heading-{{ heading.id }}">
  <mj-column>
    <mj-text align="left" color="#000000" line-height="44px">
      <h2 style="font-size:34px;color:#ff9933">{{ heading.title }}</h2>
    </mj-text>
    {% if heading.center_text %}
    <mj-text align="center">
      <p style="font-size:24px">{{ heading.center_text|linebreaksbr }}</p>
    </mj-text>
    {% endif %}
    {% if heading.right_text %}
    <mj-text align="right" color="#ff9933" font-size="24px" line-height="34px">
      <p>{{ heading.right_text|linebreaksbr }}</p>
    </mj-text>
    {% endif %}
  </mj-column>
</mj-section>

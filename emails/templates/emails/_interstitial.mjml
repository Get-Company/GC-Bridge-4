<mj-section css-class="editor-heading-{{ heading.id }}">
  <mj-column>
    <mj-text align="left" color="#000000" line-height="46px" padding-top="5px" padding-bottom="5px">
      <h2 style="font-size:34px;line-height:46px;margin:0;color:{{ accent_color }}">{{ heading.title }}</h2>
    </mj-text>
    {% if heading.center_text %}
    <mj-text align="center" font-size="24px" line-height="34px">
      <p style="font-size:24px;line-height:34px">{{ heading.center_text|linebreaksbr }}</p>
    </mj-text>
    {% endif %}
    {% if heading.right_text %}
    <mj-text align="right" color="{{ accent_color }}" font-size="24px" line-height="34px">
      <p>{{ heading.right_text|linebreaksbr }}</p>
    </mj-text>
    {% endif %}
    {% if heading.image_url %}
    <mj-image src="{{ heading.image_url }}" alt="{{ heading.title }}" width="560px" padding-top="14px" />
    {% endif %}
  </mj-column>
</mj-section>
